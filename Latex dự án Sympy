\section{Giới thiệu về thư viện SymPy}

\begin{theorybox}
\textbf{SymPy} (Symbolic Python) là một thư viện nguồn mở của ngôn ngữ lập trình Python, được thiết kế chuyên biệt để thực hiện các phép tính toán học ký hiệu (symbolic mathematics). Khác với các thư viện tính toán số học (numerical computation) thông thường, SymPy giữ nguyên bản chất đại số của các biểu thức, cho phép tính toán với các hằng số chính xác, phân số và các biến ký hiệu mà không bị làm tròn thành số thập phân. Đặc biệt, thư viện này còn hỗ trợ xuất kết quả dưới dạng mã \LaTeX, giúp việc trình bày công thức vô cùng tiện lợi.
\end{theorybox}

\subsection{Cài đặt và sử dụng SymPy}
Để bắt đầu sử dụng thư viện SymPy, môi trường máy tính cần được cài đặt sẵn ngôn ngữ Python. Sau đó, thư viện có thể được cài đặt dễ dàng thông qua công cụ quản lý gói \texttt{pip} bằng lệnh sau trên Terminal (hoặc Command Prompt):

\begin{lstlisting}[language=bash, keywordstyle=\color{black}]
pip install sympy
\end{lstlisting}

Khi thư viện đã được cài đặt, ta chỉ cần gọi nó vào chương trình Python để bắt đầu sử dụng:

\begin{lstlisting}
import sympy as sp
\end{lstlisting}

Kể từ đây, mọi sức mạnh tính toán đại số của SymPy đã sẵn sàng để được áp dụng vào việc giải quyết các bài toán ma trận được trình bày trong các chương tiếp theo của báo cáo.
\chapter{Giới thiệu các lệnh SymPy được sử dụng}

Trong chương này, chúng tôi tổng hợp và giới thiệu cú pháp cũng như chức năng của các lệnh trong thư viện \texttt{SymPy} đã được áp dụng để giải quyết các bài toán ma trận trong dự án. Việc nắm vững các lệnh này là cơ sở để hiểu rõ phần cài đặt thuật toán và mã nguồn ở các chương sau.

\section{Khai báo thư viện và khởi tạo ma trận}

\begin{itemize}[label=\textcolor{headingcolor}{\textbullet}]
    \item \textbf{Khai báo thư viện:} Nhập thư viện SymPy vào môi trường làm việc và gán tên viết tắt là \texttt{sp} để tiện lợi khi gọi các hàm.
    \begin{lstlisting}
import sympy as sp
    \end{lstlisting}

    \item \textbf{Tạo ma trận thông thường:} Sử dụng đối tượng \texttt{sp.Matrix()} với đầu vào là một danh sách (list) chứa các hàng của ma trận.
    \begin{lstlisting}
A = sp.Matrix([
    [1, 2], 
    [3, 4]
])
    \end{lstlisting}

    \item \textbf{Tạo ma trận đặc biệt:} \texttt{sp.zeros(m, n)} để tạo ma trận không kích thước $m \times n$, và \texttt{sp.eye(n)} để tạo ma trận đơn vị cấp $n$.
    \begin{lstlisting}
O = sp.zeros(2, 2)
I = sp.eye(3)
    \end{lstlisting}

    \item \textbf{Các hàm bổ trợ toán học:} Khai báo số hữu tỉ (phân số) để hệ thống giữ nguyên độ chính xác tuyệt đối mà không bị làm tròn, đồng thời khai báo biến ký hiệu toán học đại số.
    \begin{lstlisting}
# Khai bao phan so 1/3
frac = sp.Rational(1, 3)

# Khai bao bien x, y, z
x, y, z = sp.symbols('x y z')
    \end{lstlisting}
\end{itemize}

\section{Các phép toán ma trận cơ bản}

Các phép toán đại số trên ma trận được SymPy hỗ trợ rất trực quan thông qua các toán tử cơ bản và phương thức tích hợp sẵn của đối tượng \texttt{Matrix}.

\begin{itemize}[label=\textcolor{headingcolor}{\textbullet}]
    \item \textbf{Cộng, trừ, nhân:} Sử dụng trực tiếp các ký hiệu toán tử lần lượt là \texttt{+}, \texttt{-}, \texttt{*}.
    \begin{lstlisting}
C = A + B
D = A - B
E = 4 * A     # Nhan ma tran voi so vo huong
F = A * B     # Nhan hai ma tran
    \end{lstlisting}

    \item \textbf{Các đặc trưng của ma trận:} SymPy cung cấp các phương thức để tìm chuyển vị (\texttt{.T}), định thức (\texttt{.det()}), và ma trận nghịch đảo (\texttt{.inv()}).
    \begin{lstlisting}
A_T = A.T      # Ma tran chuyen vi
d = A.det()    # Dinh thuc
A_inv = A.inv() # Ma tran nghich dao
    \end{lstlisting}
\end{itemize}

\section{Biến đổi sơ cấp và hạng của ma trận}

\begin{itemize}[label=\textcolor{headingcolor}{\textbullet}]
    \item \textbf{Tạo bản sao ma trận:} Các lệnh biến đổi sơ cấp thường làm thay đổi trực tiếp lên đối tượng. Do đó, dùng phương thức \texttt{.copy()} để tạo bản sao nếu muốn giữ lại ma trận gốc.
    \begin{lstlisting}
B = A.copy()
    \end{lstlisting}

    \item \textbf{Biến đổi sơ cấp trên hàng:} Dùng phương thức \texttt{row\_swap} để đổi chỗ và \texttt{row\_op} kết hợp với hàm \texttt{lambda} để thực hiện tính toán trên hàng. (Lưu ý: chỉ số hàng/cột bắt đầu từ $0$).
    \begin{lstlisting}
# Doi cho hang 1 va hang 3
A.row_swap(0, 2)

# Nhan hang 2 voi 2
A.row_op(1, lambda val, j: 2 * val)

# Cong (-2) lan hang 1 vao hang 2
A.row_op(1, lambda val, j: val - 2 * A[0, j])
    \end{lstlisting}

    \item \textbf{Dạng bậc thang và hạng:} Chuyển ma trận về dạng bậc thang (\texttt{echelon\_form()}), bậc thang rút gọn RREF (\texttt{rref()}) và tính hạng của ma trận (\texttt{rank()}). Lệnh \texttt{rref()} trả về ma trận kết quả và vị trí các cột trụ.
    \begin{lstlisting}
E = A.echelon_form()
R, pivot_cols = A.rref()
r = A.rank()
    \end{lstlisting}
\end{itemize}

\section{Giải hệ phương trình tuyến tính}

SymPy cung cấp nhiều công cụ linh hoạt để xử lý bài toán hệ phương trình tuyến tính dưới dạng ma trận $AX = B$.

\begin{itemize}[label=\textcolor{headingcolor}{\textbullet}]
    \item \textbf{Tạo ma trận mở rộng:} Dùng phương thức \texttt{row\_join()} để ghép ma trận cột hệ số tự do $B$ vào bên phải ma trận hệ số $A$.
    \begin{lstlisting}
Ab = A.row_join(B)
    \end{lstlisting}

    \item \textbf{Phương pháp Gauss-Jordan:} Giải và trả về ngay ma trận nghiệm kèm theo các tham số (nếu có).
    \begin{lstlisting}
solution, params = A.gauss_jordan_solve(B)
    \end{lstlisting}

    \item \textbf{Giải hệ tổng quát linsolve():} Đây là hàm mạnh mẽ nhất để giải hệ tuyến tính, trả về dạng tập nghiệm. Hàm này hoạt động tốt cho cả trường hợp hệ vô nghiệm (trả về tập rỗng), nghiệm duy nhất hoặc vô số nghiệm.
    \begin{lstlisting}
sol_set = sp.linsolve((A, B))
    \end{lstlisting}

    \item \textbf{Kiểm tra nghiệm:} Dùng phương thức \texttt{.subs()} để thay thế (substitution) tập giá trị nghiệm tìm được ngược trở lại vào phương trình ban đầu nhằm kiểm tra tính đúng đắn.
    \begin{lstlisting}
# Thay the tap gia tri vao bieu thuc eq
result = eq.subs({x: sp.Rational(1, 3), y: sp.Rational(10, 9)})
    \end{lstlisting}
\end{itemize}
\chapter{Giải một số bài toán về ma trận bằng SymPy}

Trong chương này, chúng tôi sử dụng thư viện \texttt{SymPy} trong ngôn ngữ lập trình Python để giải quyết một số bài toán cơ bản về ma trận. Các nội dung được tập trung nghiên cứu gồm: thực hiện các phép biến đổi sơ cấp trên ma trận, xác định hạng của ma trận và giải hệ phương trình tuyến tính.

Việc sử dụng \texttt{SymPy} giúp thực hiện các phép tính ma trận một cách nhanh chóng, chính xác và hạn chế những sai sót có thể xảy ra khi tính toán bằng tay. Bên cạnh việc sử dụng các hàm có sẵn của thư viện, các ví dụ trong chương còn đối chiếu với phương pháp tính toán truyền thống nhằm làm rõ bản chất toán học của từng bài toán.

Trước khi thực hiện các phép tính, cần khai báo thư viện \texttt{SymPy} bằng lệnh:

\begin{lstlisting}
import sympy as sp
\end{lstlisting}

Trong toàn bộ chương này, ký hiệu \texttt{sp} được sử dụng thay cho tên đầy đủ của thư viện \texttt{SymPy}.

